// qberror.nv — why a statement will not render.
//
// EVERY FAULT IS ABOUT THE STATEMENT, NEVER ABOUT THE DATABASE.  This
// package does not connect to anything, so there is no "table not
// found" here and no "constraint violated": everything below is
// something wrong with the tree the caller built, or something the
// chosen dialect cannot say.  That is the whole of the vocabulary, and
// keeping it that narrow is what makes a fault from this package
// actionable — it is always a line of the caller's own program.
//
// THE TWO KINDS, AND THE DIFFERENCE MATTERS.  A `QbMalformed*` fault
// is wrong in every dialect and would be wrong tomorrow too; a
// `QbUnsupported` is a perfectly good statement that this dialect
// cannot express.  A caller porting to PostgreSQL cares only about the
// second list, and `qbrender.unsupported` answers exactly it.
//
// A FAULT NAMES A PATH.  "The join's ON clause is missing" is not
// actionable in a query with four joins; `joins[2].on` is.  `at` is a
// path into the statement in the spelling the AST uses, so a caller
// reading a fault can find the expression in their own builder chain.

use std.list
use qbdialect

// What is wrong.
pub enum QbFaultKind
    // A join other than `QbCross` carried no `ON` condition.  Refused
    // rather than rendered, because an inner join with no condition is
    // a cross join written by accident, and on two tables of a million
    // rows it is the single most expensive typo in SQL.
    QbJoinWithoutOn
    // `QbIn` carried an empty list.  `IN ()` is a syntax error in
    // every dialect here, and the two repairs — render `FALSE`, or
    // drop the clause — return opposite row sets, so choosing one for
    // the caller would be choosing which rows they get.
    QbEmptyInList
    // A `QbCase` whose `whens` and `thens` are different lengths.
    QbCaseArity(whens: Int, thens: Int)
    // An `INSERT` row of a different length from its column list.
    QbInsertArity(columns: Int, values: Int, row: Int)
    // An `INSERT` with no column list.  Refused because an `INSERT`
    // without one depends on the table's declaration order, which a
    // builder cannot see and which changes the day somebody adds a
    // column.
    QbInsertNoColumns
    // An `INSERT` that set both `rows` and `from_select`.
    QbInsertTwoSources
    // An `INSERT` with neither.
    QbInsertNoSource
    // An `UPDATE` with no assignments.
    QbUpdateNothingSet
    // A name that cannot be written in this dialect: it is not a bare
    // identifier, and the dialect cannot quote one.  `QbSqlEngine`
    // reaches this for every column named after a reserved word.
    QbUnquotableIdent(name: Str, dialect: qbdialect.QbDialect)
    // An identifier containing the dialect's own quote character, or a
    // NUL.  Refused in every dialect: doubling the quote is the
    // correct escape and this package does it, but a NUL in an
    // identifier terminates the string somewhere downstream and there
    // is no escape for it.
    QbUnwritableIdent(name: Str)
    // The statement uses something this dialect does not have.  The
    // one kind a port has to read, and the one `unsupported` answers.
    QbUnsupported(feature: qbdialect.QbFeature, dialect: qbdialect.QbDialect)
    // A subquery in `FROM` with no alias, in a dialect that requires
    // one.
    QbSubqueryNeedsAlias
    // A CTE with no name, or two CTEs with the same name.
    QbCteName(name: Str)
    // A set operation arm whose select has its own `ORDER BY` or
    // `LIMIT`.  Legal in SQLite and refused by PostgreSQL, and the
    // parenthesising that would make it portable changes what the
    // clause applies to — so it is refused everywhere rather than
    // rendered one way for one dialect.
    QbSetArmOrdered
    // Nesting deeper than `QbRenderOptions.max_depth`.
    QbTooDeep(limit: Int)
    // More bound parameters than `QbRenderOptions.max_params`.  Every
    // driver has a ceiling — PostgreSQL's wire protocol has 65 535 —
    // and a query built out of a list the caller did not bound reaches
    // it as a runtime error from the server rather than here.
    QbTooManyParams(limit: Int)
    // An `UPDATE` or `DELETE` with no `WHERE`, under
    // `QbRenderOptions.require_where`.
    //
    // New in 0.1.0, and the reason it exists is that the switch that
    // refuses an unguarded write had no kind to refuse it with:
    // `require_where` was an option in the interface release with
    // nothing in this enum to answer it.  It is a mistake in the
    // statement only in the presence of the option — `unguarded` is
    // the question, and by default the statement renders.
    QbWhereRequired
    // Spliced text in the statement, under
    // `QbRenderOptions.forbid_raw`.  The second kind added in 0.1.0,
    // for the same reason as the first: `forbid_raw` is a switch whose
    // refusal had no name here.
    QbRawForbidden

// What is wrong, and where in the statement.
pub struct QbFault
    // Which of the above.
    kind: QbFaultKind
    // A path into the statement, in the AST's own spelling:
    // `joins[2].on`, `columns[0].expr`, `ctes[1].body.where_`.  Empty
    // for a fault about the statement as a whole.
    at: Str

// ── The sentence ─────────────────────────────────────────────────────
//
// `impl Error for QbFault` and the free `message` are one text, which
// is why they both come here rather than one of them holding it.

// `joins[2].on: a join other than a cross join needs an ON condition`,
// or the same without the path for a fault about the whole statement.
fn sentence(f: QbFault) -> Str
    let loc = if f.at == ""
        ""
    else
        f.at + ": "
    loc + clause(f.kind)

// What is wrong, without the path.  Every dialect-specific fault names
// its dialect here; the two switches name the option that refused,
// because that is what the caller has to go and turn off.
fn clause(kind: QbFaultKind) -> Str
    match kind
        QbJoinWithoutOn                     => "a join other than a cross join needs an ON condition; QbCross is how a cross join is written"
        QbEmptyInList                       => "IN () has no values in it; guard the empty list or pick another condition"
        QbCaseArity(whens, thens)           => "CASE has ${whens} WHEN branch(es) and ${thens} THEN branch(es)"
        QbInsertArity(columns, values, row) => "INSERT row ${row} holds ${values} value(s) for ${columns} column(s)"
        QbInsertNoColumns                   => "INSERT must name its columns; the table's declaration order is not visible here"
        QbInsertTwoSources                  => "INSERT has both rows and a SELECT"
        QbInsertNoSource                    => "INSERT has neither rows nor a SELECT"
        QbUpdateNothingSet                  => "UPDATE sets no column"
        QbUnquotableIdent(name, dialect)    => "${name} is not a bare identifier and ${qbdialect.name(dialect)} cannot quote one"
        QbUnwritableIdent(name)             => "${name} holds a quote or a zero byte, which no dialect can write in an identifier"
        QbUnsupported(feature, dialect)     => "${qbdialect.name(dialect)} has no ${qbdialect.feature_name(feature)}"
        QbSubqueryNeedsAlias                => "a subquery in FROM needs an alias in this dialect"
        QbCteName(name)                     => "${name} is not a usable CTE name; a CTE name is non-empty and used once"
        QbSetArmOrdered                     => "a set operation's arm carries its own ORDER BY or LIMIT"
        QbTooDeep(limit)                    => "the statement nests deeper than ${limit}"
        QbTooManyParams(limit)              => "the statement binds more than ${limit} values"
        QbWhereRequired                     => "an UPDATE or DELETE with no WHERE, and require_where is on"
        QbRawForbidden                      => "the statement carries spliced text, and forbid_raw is on"

// `QbFault` is an `Error`, which is what lets `Result<T, QbFault>`
// exist at all — every fallible signature in `qbrender` answers with
// one, from `render` and `render_str` through `render_len` to
// `write_ident` and `write_literal`.
impl Error for QbFault
    // The one-line message: `qberror.message`'s sentence, the kind
    // named with the path into the statement it is about and, where
    // the fault has one, the dialect.
    //
    fn message(self) -> Str
        sentence(self)

// A fault, built.
//
// ```novo
// use qberror
//
// fn main() [io]
//     println(qberror.fault(QbJoinWithoutOn, "joins[2].on").at)
// ```
pub fn fault(kind: QbFaultKind, at: Str) -> QbFault []
    QbFault { kind: kind, at: at }

// The short name of a fault kind: `join-without-on`, `empty-in-list`,
// `unsupported`.
//
// ```novo
// use qberror
//
// fn main() [io]
//     println(qberror.kind_name(QbJoinWithoutOn))
// ```
pub fn kind_name(kind: QbFaultKind) -> Str []
    match kind
        QbJoinWithoutOn                     => "join-without-on"
        QbEmptyInList                       => "empty-in-list"
        QbCaseArity(whens, thens)           => "case-arity"
        QbInsertArity(columns, values, row) => "insert-arity"
        QbInsertNoColumns                   => "insert-no-columns"
        QbInsertTwoSources                  => "insert-two-sources"
        QbInsertNoSource                    => "insert-no-source"
        QbUpdateNothingSet                  => "update-nothing-set"
        QbUnquotableIdent(name, dialect)    => "unquotable-ident"
        QbUnwritableIdent(name)             => "unwritable-ident"
        QbUnsupported(feature, dialect)     => "unsupported"
        QbSubqueryNeedsAlias                => "subquery-needs-alias"
        QbCteName(name)                     => "cte-name"
        QbSetArmOrdered                     => "set-arm-ordered"
        QbTooDeep(limit)                    => "too-deep"
        QbTooManyParams(limit)              => "too-many-params"
        QbWhereRequired                     => "where-required"
        QbRawForbidden                      => "raw-forbidden"

// One line a person can act on, naming the path and, where the fault
// has one, the dialect.
//
// ```novo
// use qberror
//
// fn main() [io]
//     println(qberror.message(qberror.fault(QbJoinWithoutOn, "joins[2].on")))
// ```
pub fn message(f: QbFault) -> Str []
    sentence(f)

// True when the fault is a dialect's limitation rather than a mistake
// in the statement — `QbUnsupported`, `QbUnquotableIdent` and
// `QbSubqueryNeedsAlias`.
//
// The split a port reads: a caller moving from SQLite to PostgreSQL
// wants this list and not the other one.
//
// ```novo
// use qberror
//
// fn main() [io]
//     println("${qberror.is_dialect_limit(qberror.fault(QbJoinWithoutOn, ""))}")
// ```
pub fn is_dialect_limit(f: QbFault) -> Bool []
    match f.kind
        QbUnsupported(feature, dialect)     => true
        QbUnquotableIdent(name, dialect)    => true
        QbSubqueryNeedsAlias                => true
        QbJoinWithoutOn                     => false
        QbEmptyInList                       => false
        QbCaseArity(whens, thens)           => false
        QbInsertArity(columns, values, row) => false
        QbInsertNoColumns                   => false
        QbInsertTwoSources                  => false
        QbInsertNoSource                    => false
        QbUpdateNothingSet                  => false
        QbUnwritableIdent(name)             => false
        QbCteName(name)                     => false
        QbSetArmOrdered                     => false
        QbTooDeep(limit)                    => false
        QbTooManyParams(limit)              => false
        QbWhereRequired                     => false
        QbRawForbidden                      => false

// The faults in `faults` that are dialect limitations, in order.
//
// ```novo
// use std.list
// use qberror
//
// fn main() [io]
//     println("${list.len(qberror.dialect_limits([]))}")
// ```
pub fn dialect_limits(faults: [QbFault]) -> [QbFault] []
    list.filter(faults, f => is_dialect_limit(f))

// The faults in `faults` that are mistakes in the statement, in order.
//
// ```novo
// use std.list
// use qberror
//
// fn main() [io]
//     println("${list.len(qberror.malformed([]))}")
// ```
pub fn malformed(faults: [QbFault]) -> [QbFault] []
    list.filter(faults, f => not is_dialect_limit(f))
