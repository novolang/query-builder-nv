// qbbuild.nv — the builder chain: an empty statement, and one call per
// fact added to it.
//
// WHY THERE IS A MODULE FOR THIS AT ALL.  A query is assembled
// conditionally: three filters from a request, two of which are
// absent.  A struct literal is the wrong shape for that — it names
// every field at once and then never grows — and one call per fact
// added is the shape the other builders have too (SeaQuery, sqlx and
// SQLAlchemy Core all read like this).
//
// A LITERAL IS WRITABLE FROM ANOTHER MODULE, which is measured rather
// than assumed: the interface release's first paragraph said otherwise
// and a probe on this compiler refuses it.  What a literal cannot do is
// grow, and the fields of these structs are immutable — so every step
// of the chain is a fresh literal, and the calls here are names for
// those literals a caller would otherwise write out by hand.
//
// EVERY CALL ANSWERS A NEW STATEMENT.  `where_(s, e)` does not mutate
// `s`; it answers the select with one more condition.  So a caller
// building a query in a loop threads it, and a caller building two
// queries from one base shares the base rather than copying it.
//
// `and_where` IS THE ONE TO USE, and `where_` is beneath it.  A
// builder that only had `where_` makes every caller write
// `match existing { Some(e) => QbAnd(e, new), None => new }`, and the
// caller who forgets replaces the tenant filter with the search
// filter.  `and_where` is that four lines, once.
//
// THE VALUE GOES IN AT THE POINT OF USE.  `eq(col, v)` takes a
// `QbValue` and builds `QbCmp(QbEq, QbCol(col), QbBind(v))`, so the
// ordinary comparison binds by construction and a caller has to go out
// of their way — `QbLit` or `QbRaw` — to put a value in the text.

use std.list
use std.str
use qbast

// ── The parts, and the copies a call answers ─────────────────────────
//
// Every `with_*` below answers a COPY of a statement with one field
// replaced, and that is what makes each call in the sections above a
// new statement rather than a shared one.  The shape is forced: a
// struct field is immutable unless it is declared `var`, these structs
// are reference types, and a write through a shared one would be seen
// through every name that holds the statement — the caller's base
// among them.  A fresh literal is the only spelling of "a new
// statement", and it is spelled once per field here rather than once
// per call below.

// A value at the point it is used.
fn bound(v: qbast.QbValue) -> qbast.QbExpr
    QbBind(v)

// The same, one per element.
fn bound_all(values: [qbast.QbValue]) -> [qbast.QbExpr]
    var out: [qbast.QbExpr] = []
    for v in values
        list.push(out, bound(v))
    out

// A selected column, by name, with no alias.
fn named_column(name: Str) -> qbast.QbColumn
    QbColumn { expr: QbCol(name), as_name: "" }

// The same, one per name, in the order the names are given.
fn named_columns(names: [Str]) -> [qbast.QbColumn]
    var cols: [qbast.QbColumn] = []
    for n in names
        list.push(cols, named_column(n))
    cols

// `e` ANDed onto `prev`, which is absent when there was no condition
// yet.
fn and_onto(prev: ?qbast.QbExpr, e: qbast.QbExpr) -> qbast.QbExpr
    match prev
        Some(existing) => QbAnd(existing, e)
        None           => e

// `e` ORed onto `prev`, which is absent when there was no condition
// yet.
fn or_onto(prev: ?qbast.QbExpr, e: qbast.QbExpr) -> qbast.QbExpr
    match prev
        Some(existing) => QbOr(existing, e)
        None           => e

// `parts` folded with `QbAnd`, or with `QbOr` when `is_and` is false.
//
// The empty fold answers a LITERAL — true for `AND`, false for `OR` —
// because those are the two identities and they are opposite; a
// one-element fold answers that element rather than a wrapper around
// it.
fn fold_parts(parts: [qbast.QbExpr], is_and: Bool) -> qbast.QbExpr
    if list.len(parts) == 0
        QbLit(QbBool(is_and))
    else if list.len(parts) == 1
        list.get(parts, 0)
    else
        var acc = list.get(parts, 0)
        for i in 1..list.len(parts)
            acc = combined(is_and, acc, list.get(parts, i))
        acc

// One step of the fold above.
fn combined(is_and: Bool, a: qbast.QbExpr, b: qbast.QbExpr) -> qbast.QbExpr
    if is_and
        QbAnd(a, b)
    else
        QbOr(a, b)

// A join.  A cross join carries no `ON` — `CROSS JOIN t ON …` is a
// syntax error in SQLite and PostgreSQL — so a condition passed for one
// is dropped rather than written into SQL that cannot parse.  This
// signature has no spelling for "no condition", so the drop happens
// here; `CHANGELOG.md` records it under `### Known`.
fn assembled_join(kind: qbast.QbJoinKind, table: Str, as_name: Str,
                  on: qbast.QbExpr) -> qbast.QbJoin
    if kind == QbCross
        QbJoin { kind: kind, source: QbTable(table, as_name), on: None }
    else
        QbJoin { kind: kind, source: QbTable(table, as_name), on: Some(on) }

// The item a count selects.
fn count_column() -> qbast.QbColumn
    QbColumn { expr: QbFn("COUNT", [QbStar]), as_name: "" }

// `s` with its `SELECT` items replaced.
fn with_columns(s: qbast.QbSelect, columns: [qbast.QbColumn]) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with `SELECT DISTINCT` set or cleared.
fn with_distinct(s: qbast.QbSelect, on: Bool) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: on, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins,
               where_: s.where_, group_by: s.group_by, having: s.having,
               order_by: s.order_by, limit: s.limit, offset: s.offset,
               set_arms: s.set_arms, for_update: s.for_update }

// `s` reading from `src`, or from nothing when it is absent.
fn with_from(s: qbast.QbSelect, src: ?qbast.QbSource) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: src, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its joins replaced, in the order they are applied.
fn with_joins(s: qbast.QbSelect, joins: [qbast.QbJoin]) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its `WHERE` replaced — absent for no condition.
fn with_where(s: qbast.QbSelect, cond: ?qbast.QbExpr) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: cond,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its `GROUP BY` terms replaced.
fn with_group_by(s: qbast.QbSelect, terms: [qbast.QbExpr]) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: terms, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its `HAVING` replaced — absent for no condition.
fn with_having(s: qbast.QbSelect, cond: ?qbast.QbExpr) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: cond, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its `ORDER BY` terms replaced.
fn with_order_by(s: qbast.QbSelect, terms: [qbast.QbOrder]) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: terms,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its row limit replaced.  `-1` is no limit.
fn with_limit(s: qbast.QbSelect, n: Int) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: n, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its offset replaced.  `-1` is no offset.
fn with_offset(s: qbast.QbSelect, n: Int) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: n, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its `WITH` clauses replaced, in order.
fn with_ctes(s: qbast.QbSelect, ctes: [qbast.QbCte]) -> qbast.QbSelect
    QbSelect { ctes: ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: s.set_arms,
               for_update: s.for_update }

// `s` with its set-operation arms replaced, in order.
fn with_set_arms(s: qbast.QbSelect, arms: [qbast.QbSetArm]) -> qbast.QbSelect
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: s.columns, from: s.from, joins: s.joins, where_: s.where_,
               group_by: s.group_by, having: s.having, order_by: s.order_by,
               limit: s.limit, offset: s.offset, set_arms: arms,
               for_update: s.for_update }

// `i` with its rows replaced, each row already bound.
fn with_rows(i: qbast.QbInsert, rows: [[qbast.QbExpr]]) -> qbast.QbInsert
    QbInsert { ctes: i.ctes, table: i.table, columns: i.columns, rows: rows,
               from_select: i.from_select, conflict: i.conflict,
               conflict_columns: i.conflict_columns, conflict_set: i.conflict_set,
               conflict_where: i.conflict_where, returning: i.returning }

// `i` with its source select replaced — absent when it is filled from
// rows.
fn with_insert_select(i: qbast.QbInsert, inner: ?qbast.QbSelect) -> qbast.QbInsert
    QbInsert { ctes: i.ctes, table: i.table, columns: i.columns, rows: i.rows,
               from_select: inner, conflict: i.conflict,
               conflict_columns: i.conflict_columns, conflict_set: i.conflict_set,
               conflict_where: i.conflict_where, returning: i.returning }

// `i` with its conflict clause replaced: what to do, the target columns
// and the assignments.
fn with_conflict(i: qbast.QbInsert, kind: qbast.QbConflict, target: [Str],
                 sets: [qbast.QbAssign]) -> qbast.QbInsert
    QbInsert { ctes: i.ctes, table: i.table, columns: i.columns, rows: i.rows,
               from_select: i.from_select, conflict: kind,
               conflict_columns: target, conflict_set: sets,
               conflict_where: i.conflict_where, returning: i.returning }

// `i` with its `RETURNING` items replaced.
fn with_insert_returning(i: qbast.QbInsert, items: [qbast.QbColumn]) -> qbast.QbInsert
    QbInsert { ctes: i.ctes, table: i.table, columns: i.columns, rows: i.rows,
               from_select: i.from_select, conflict: i.conflict,
               conflict_columns: i.conflict_columns, conflict_set: i.conflict_set,
               conflict_where: i.conflict_where, returning: items }

// `u` with its assignments replaced.
fn with_updates(u: qbast.QbUpdate, sets: [qbast.QbAssign]) -> qbast.QbUpdate
    QbUpdate { ctes: u.ctes, table: u.table, set: sets, from: u.from,
               where_: u.where_, returning: u.returning }

// `u` with its condition replaced — absent for no condition.
fn with_update_where(u: qbast.QbUpdate, cond: ?qbast.QbExpr) -> qbast.QbUpdate
    QbUpdate { ctes: u.ctes, table: u.table, set: u.set, from: u.from,
               where_: cond, returning: u.returning }

// `u` with its `RETURNING` items replaced.
fn with_update_returning(u: qbast.QbUpdate, items: [qbast.QbColumn]) -> qbast.QbUpdate
    QbUpdate { ctes: u.ctes, table: u.table, set: u.set, from: u.from,
               where_: u.where_, returning: items }

// `d` with its condition replaced — absent for no condition.
fn with_delete_where(d: qbast.QbDelete, cond: ?qbast.QbExpr) -> qbast.QbDelete
    QbDelete { ctes: d.ctes, table: d.table, where_: cond, returning: d.returning }

// `d` with its `RETURNING` items replaced.
fn with_delete_returning(d: qbast.QbDelete, items: [qbast.QbColumn]) -> qbast.QbDelete
    QbDelete { ctes: d.ctes, table: d.table, where_: d.where_, returning: items }

// ── values ───────────────────────────────────────────────────────────

// An integer value.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.int_value(7)}")
// ```
pub fn int_value(v: Int) -> qbast.QbValue []
    QbInt(v)

// A text value.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.text_value("ada")}")
// ```
pub fn text_value(v: Str) -> qbast.QbValue []
    QbText(v)

// A float value.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.float_value(1.5)}")
// ```
pub fn float_value(v: Float) -> qbast.QbValue []
    QbFloat(v)

// A boolean value.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.bool_value(true)}")
// ```
pub fn bool_value(v: Bool) -> qbast.QbValue []
    QbBool(v)

// A blob value.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.blob_value([])}")
// ```
pub fn blob_value(v: [u8]) -> qbast.QbValue []
    QbBlob(v)

// ── the comparisons, which bind by construction ──────────────────────

// `column = ?`, with `v` bound.
//
// The call a caller makes a hundred times, and the reason the binding
// is not a separate step: there is no spelling of this that puts the
// value in the text.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.eq("id", qbbuild.int_value(7))}")
// ```
pub fn eq(column: Str, v: qbast.QbValue) -> qbast.QbExpr []
    QbCmp(QbEq, QbCol(column), bound(v))

// `column <> ?`, with `v` bound.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.ne("id", qbbuild.int_value(7))}")
// ```
pub fn ne(column: Str, v: qbast.QbValue) -> qbast.QbExpr []
    QbCmp(QbNe, QbCol(column), bound(v))

// `column < ?`, with `v` bound.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.lt("age", qbbuild.int_value(30))}")
// ```
pub fn lt(column: Str, v: qbast.QbValue) -> qbast.QbExpr []
    QbCmp(QbLt, QbCol(column), bound(v))

// `column > ?`, with `v` bound.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.gt("age", qbbuild.int_value(30))}")
// ```
pub fn gt(column: Str, v: qbast.QbValue) -> qbast.QbExpr []
    QbCmp(QbGt, QbCol(column), bound(v))

// `column <= ?`, with `v` bound.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.le("age", qbbuild.int_value(30))}")
// ```
pub fn le(column: Str, v: qbast.QbValue) -> qbast.QbExpr []
    QbCmp(QbLe, QbCol(column), bound(v))

// `column >= ?`, with `v` bound.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.ge("age", qbbuild.int_value(30))}")
// ```
pub fn ge(column: Str, v: qbast.QbValue) -> qbast.QbExpr []
    QbCmp(QbGe, QbCol(column), bound(v))

// `column IN (?, ?, …)`, every value bound.
//
// An empty list builds an expression the render REFUSES — see
// `qberror.QbEmptyInList` — rather than one that quietly returns no
// rows or all of them.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.in_values("id", [qbbuild.int_value(1)])}")
// ```
pub fn in_values(column: Str, values: [qbast.QbValue]) -> qbast.QbExpr []
    QbIn(QbCol(column), bound_all(values), false)

// `column LIKE ?`, with the pattern bound.
//
// The pattern is bound rather than inlined, which means `%` and `_`
// inside a user's search term are still wildcards — escaping those is
// the caller's decision, because "search for a literal percent sign"
// and "search with a wildcard" are both real and the library cannot
// tell which was meant.  `escape_like` is the helper for the first.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.like("name", "ada%")}")
// ```
pub fn like(column: Str, pattern: Str) -> qbast.QbExpr []
    QbLike(QbCol(column), bound(QbText(pattern)), "", false)

// `pattern` with `%`, `_` and the escape character itself prefixed by
// `\`, for a search that means the characters literally.
//
// Paired with `QbLike`'s `escape` field, which has to be set to `\`
// for this to mean anything — the two are one decision and the doc
// comment on each names the other.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println(qbbuild.escape_like("100%"))
// ```
pub fn escape_like(pattern: Str) -> Str []
    var out = ""
    for i in 0..str.len(pattern)
        let b = str.byte_at_or(pattern, i, 0)
        if b == 92 or b == 37 or b == 95
            out = out + "\\" + str.from_byte(b)
        else
            out = out + str.from_byte(b)
    out

// `column IS NULL`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.is_null("deleted_at")}")
// ```
pub fn is_null(column: Str) -> qbast.QbExpr []
    QbIsNull(QbCol(column), false)

// `column IS NOT NULL`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.is_not_null("deleted_at")}")
// ```
pub fn is_not_null(column: Str) -> qbast.QbExpr []
    QbIsNull(QbCol(column), true)

// `column BETWEEN ? AND ?`, both bound, both ends included.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.between("age", qbbuild.int_value(18), qbbuild.int_value(30))}")
// ```
pub fn between(column: Str, low: qbast.QbValue, high: qbast.QbValue) -> qbast.QbExpr []
    QbBetween(QbCol(column), bound(low), bound(high), false)

// `a AND b`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let a = qbbuild.is_null("x")
//     println("${qbbuild.all_of([a, a])}")
// ```
pub fn all_of(parts: [qbast.QbExpr]) -> qbast.QbExpr []
    fold_parts(parts, true)

// `a OR b`.
//
// An empty list answers a condition that is always FALSE, which is
// what "match any of nothing" means; `all_of([])` answers one that is
// always true, for the same reason in the other direction.  Both are
// stated here because a caller folding a list of filters hits the
// empty case first and the two identities are opposite.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let a = qbbuild.is_null("x")
//     println("${qbbuild.any_of([a, a])}")
// ```
pub fn any_of(parts: [qbast.QbExpr]) -> qbast.QbExpr []
    fold_parts(parts, false)

// ── SELECT ───────────────────────────────────────────────────────────

// An empty `SELECT`: no columns, no source, no conditions.
//
// Renders as `SELECT *` if nothing else is added, because a select
// with no items is not a statement any dialect accepts and `*` is what
// a caller who named nothing meant.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     println("${list.len(qbbuild.select().columns)}")
// ```
pub fn select() -> qbast.QbSelect []
    QbSelect { ctes: [], distinct: false, distinct_on: [], columns: [],
               from: None, joins: [], where_: None, group_by: [], having: None,
               order_by: [], limit: -1, offset: -1, set_arms: [],
               for_update: false }

// `s` reading from `table`, with an optional alias.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.from(qbbuild.select(), "users", "u").joins}")
// ```
pub fn from(s: qbast.QbSelect, table: Str, as_name: Str) -> qbast.QbSelect []
    with_from(s, Some(QbTable(table, as_name)))

// `s` reading from a subquery, which must have an alias in PostgreSQL
// and MySQL.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let inner = qbbuild.from(qbbuild.select(), "users", "")
//     println("${qbbuild.from_select(qbbuild.select(), inner, "u").limit}")
// ```
pub fn from_select(s: qbast.QbSelect, inner: qbast.QbSelect, as_name: Str) -> qbast.QbSelect []
    with_from(s, Some(QbSubquery(inner, as_name)))

// `s` with one more selected column, by name.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     println("${list.len(qbbuild.column(qbbuild.select(), "id").columns)}")
// ```
pub fn column(s: qbast.QbSelect, name: Str) -> qbast.QbSelect []
    let cols = list.concat(s.columns, [named_column(name)])
    with_columns(s, cols)

// `s` with one more selected expression and an `AS` name.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let e = qbbuild.is_null("x")
//     println("${list.len(qbbuild.column_as(qbbuild.select(), e, "missing").columns)}")
// ```
pub fn column_as(s: qbast.QbSelect, e: qbast.QbExpr, as_name: Str) -> qbast.QbSelect []
    let cols = list.concat(s.columns, [QbColumn { expr: e, as_name: as_name }])
    with_columns(s, cols)

// `s` with several more columns, by name.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     println("${list.len(qbbuild.columns(qbbuild.select(), ["id", "name"]).columns)}")
// ```
pub fn columns(s: qbast.QbSelect, names: [Str]) -> qbast.QbSelect []
    let cols = list.concat(s.columns, named_columns(names))
    with_columns(s, cols)

// `s` with `SELECT DISTINCT`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.distinct(qbbuild.select()).distinct}")
// ```
pub fn distinct(s: qbast.QbSelect) -> qbast.QbSelect []
    with_distinct(s, true)

// `s` with its `WHERE` REPLACED by `e`.
//
// Use `and_where` unless you mean to discard what was there.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let s = qbbuild.where_(qbbuild.select(), qbbuild.is_null("x"))
//     println("${s.limit}")
// ```
pub fn where_(s: qbast.QbSelect, e: qbast.QbExpr) -> qbast.QbSelect []
    with_where(s, Some(e))

// `s` with `e` ANDed onto whatever its `WHERE` already was.
//
// The call to reach for.  A builder with only `where_` makes every
// caller write the `match`, and the caller who forgets it replaces the
// tenant filter with the search filter — which is a data leak with no
// error message.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let s = qbbuild.and_where(qbbuild.select(), qbbuild.is_null("x"))
//     println("${qbbuild.and_where(s, qbbuild.is_null("y")).limit}")
// ```
pub fn and_where(s: qbast.QbSelect, e: qbast.QbExpr) -> qbast.QbSelect []
    with_where(s, Some(and_onto(s.where_, e)))

// `s` with `e` ORed onto whatever its `WHERE` already was.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let s = qbbuild.and_where(qbbuild.select(), qbbuild.is_null("x"))
//     println("${qbbuild.or_where(s, qbbuild.is_null("y")).limit}")
// ```
pub fn or_where(s: qbast.QbSelect, e: qbast.QbExpr) -> qbast.QbSelect []
    with_where(s, Some(or_onto(s.where_, e)))

// `s` with one more join.
//
// `on` is required for every kind but `QbCross`, and the render
// refuses a statement missing it.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let s = qbbuild.from(qbbuild.select(), "users", "u")
//     let on = qbbuild.is_null("x")
//     println("${list.len(qbbuild.join(s, QbInner, "orders", "o", on).joins)}")
// ```
pub fn join(s: qbast.QbSelect, kind: qbast.QbJoinKind, table: Str, as_name: Str,
            on: qbast.QbExpr) -> qbast.QbSelect []
    let j = assembled_join(kind, table, as_name, on)
    with_joins(s, list.concat(s.joins, [j]))

// `s` with one more `GROUP BY` term.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     println("${list.len(qbbuild.group_by(qbbuild.select(), "country").group_by)}")
// ```
pub fn group_by(s: qbast.QbSelect, column: Str) -> qbast.QbSelect []
    let terms = list.concat(s.group_by, [QbCol(column)])
    with_group_by(s, terms)

// `s` with `e` ANDed onto its `HAVING`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let s = qbbuild.and_having(qbbuild.select(), qbbuild.is_null("x"))
//     println("${s.limit}")
// ```
pub fn and_having(s: qbast.QbSelect, e: qbast.QbExpr) -> qbast.QbSelect []
    with_having(s, Some(and_onto(s.having, e)))

// `s` with one more `ORDER BY` term.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let s = qbbuild.order_by(qbbuild.select(), "created_at", true)
//     println("${list.len(s.order_by)}")
// ```
pub fn order_by(s: qbast.QbSelect, column: Str, descending: Bool) -> qbast.QbSelect []
    let term = QbOrder { expr: QbCol(column), descending: descending,
                        nulls: QbNullsDefault }
    with_order_by(s, list.concat(s.order_by, [term]))

// `s` with one more `ORDER BY` term and an explicit null placement.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let s = qbbuild.order_by_nulls(qbbuild.select(), "at", true, QbNullsLast)
//     println("${list.len(s.order_by)}")
// ```
pub fn order_by_nulls(s: qbast.QbSelect, column: Str, descending: Bool,
                      nulls: qbast.QbNulls) -> qbast.QbSelect []
    let term = QbOrder { expr: QbCol(column), descending: descending,
                        nulls: nulls }
    with_order_by(s, list.concat(s.order_by, [term]))

// `s` with a row limit.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.limit(qbbuild.select(), 50).limit}")
// ```
pub fn limit(s: qbast.QbSelect, n: Int) -> qbast.QbSelect []
    with_limit(s, n)

// `s` with an offset.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.offset(qbbuild.select(), 100).offset}")
// ```
pub fn offset(s: qbast.QbSelect, n: Int) -> qbast.QbSelect []
    with_offset(s, n)

// `s` with one more CTE in front of it.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let body = qbbuild.from(qbbuild.select(), "users", "")
//     println("${list.len(qbbuild.with_cte(qbbuild.select(), "recent", body, false).ctes)}")
// ```
pub fn with_cte(s: qbast.QbSelect, name: Str, body: qbast.QbSelect,
                recursive: Bool) -> qbast.QbSelect []
    let c = QbCte { name: name, columns: [], body: body,
                    recursive: recursive }
    with_ctes(s, list.concat(s.ctes, [c]))

// `s` with another select joined to it by a set operation.
//
// The arm may not carry its own `ORDER BY` or `LIMIT` — see
// `qberror.QbSetArmOrdered`.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let other = qbbuild.from(qbbuild.select(), "archive", "")
//     println("${list.len(qbbuild.union(qbbuild.select(), QbUnionAll, other).set_arms)}")
// ```
pub fn union(s: qbast.QbSelect, op: qbast.QbSetOp, other: qbast.QbSelect) -> qbast.QbSelect []
    let arm = QbSetArm { op: op, body: other }
    with_set_arms(s, list.concat(s.set_arms, [arm]))

// ── INSERT ───────────────────────────────────────────────────────────

// An `INSERT INTO table (columns…)` with no rows yet.
//
// The column list is required here rather than optional, because an
// `INSERT` without one depends on the table's declaration order.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     println("${list.len(qbbuild.insert("users", ["name", "email"]).columns)}")
// ```
pub fn insert(table: Str, columns: [Str]) -> qbast.QbInsert []
    QbInsert { ctes: [], table: table, columns: columns, rows: [],
               from_select: None, conflict: QbConflictError,
               conflict_columns: [], conflict_set: [], conflict_where: None,
               returning: [] }

// `i` with one more row of bound values.
//
// A row of a different length from the column list is refused at
// render, with both numbers and the row's index named.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let i = qbbuild.insert("users", ["name"])
//     println("${list.len(qbbuild.values(i, [qbbuild.text_value("ada")]).rows)}")
// ```
pub fn values(i: qbast.QbInsert, row: [qbast.QbValue]) -> qbast.QbInsert []
    let rows = list.concat(i.rows, [bound_all(row)])
    with_rows(i, rows)

// `i` filled from a select instead of from literal rows.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let i = qbbuild.insert("archive", ["id"])
//     let s = qbbuild.from(qbbuild.select(), "users", "")
//     println("${qbbuild.insert_select(i, s).table}")
// ```
pub fn insert_select(i: qbast.QbInsert, s: qbast.QbSelect) -> qbast.QbInsert []
    with_insert_select(i, Some(s))

// `i` with `ON CONFLICT DO NOTHING`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let i = qbbuild.insert("users", ["email"])
//     println("${qbbuild.on_conflict_ignore(i, ["email"]).table}")
// ```
pub fn on_conflict_ignore(i: qbast.QbInsert, target: [Str]) -> qbast.QbInsert []
    with_conflict(i, QbConflictIgnore, target, [])

// `i` with `ON CONFLICT (target) DO UPDATE SET …`.
//
// MySQL has no conflict target — it uses whichever unique index was
// hit — so `target` is dropped there and `qbrender.unsupported` names
// it before a caller relies on it.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let i = qbbuild.insert("users", ["email", "name"])
//     println("${qbbuild.on_conflict_update(i, ["email"], []).table}")
// ```
pub fn on_conflict_update(i: qbast.QbInsert, target: [Str],
                          set: [qbast.QbAssign]) -> qbast.QbInsert []
    with_conflict(i, QbConflictUpdate, target, set)

// One `column = expr` assignment.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println(qbbuild.assign("name", qbbuild.int_value(1)).column)
// ```
pub fn assign(column: Str, v: qbast.QbValue) -> qbast.QbAssign []
    QbAssign { column: column, value: bound(v) }

// One `column = <expression>` assignment, for `count = count + 1`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println(qbbuild.assign_expr("seen", qbbuild.is_null("x")).column)
// ```
pub fn assign_expr(column: Str, e: qbast.QbExpr) -> qbast.QbAssign []
    QbAssign { column: column, value: e }

// `i` with `RETURNING` items.
//
// PostgreSQL and SQLite; MySQL has none.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let i = qbbuild.insert("users", ["name"])
//     println("${list.len(qbbuild.insert_returning(i, ["id"]).returning)}")
// ```
pub fn insert_returning(i: qbast.QbInsert, names: [Str]) -> qbast.QbInsert []
    with_insert_returning(i, named_columns(names))

// ── UPDATE and DELETE ────────────────────────────────────────────────

// An `UPDATE table` with nothing set and no condition.
//
// A statement built from this and rendered without a `WHERE` updates
// every row; `qbrender.unguarded` is the check a review runs and it is
// not refused, because "set every row's flag" is a real statement.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println(qbbuild.update("users").table)
// ```
pub fn update(table: Str) -> qbast.QbUpdate []
    QbUpdate { ctes: [], table: table, set: [], from: None, where_: None, returning: [] }

// `u` with one more assignment.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let a = qbbuild.assign("name", qbbuild.text_value("ada"))
//     println("${list.len(qbbuild.set(qbbuild.update("users"), a).set)}")
// ```
pub fn set(u: qbast.QbUpdate, a: qbast.QbAssign) -> qbast.QbUpdate []
    with_updates(u, list.concat(u.set, [a]))

// `u` with `e` ANDed onto its condition.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let u = qbbuild.update_where(qbbuild.update("users"), qbbuild.is_null("x"))
//     println(u.table)
// ```
pub fn update_where(u: qbast.QbUpdate, e: qbast.QbExpr) -> qbast.QbUpdate []
    with_update_where(u, Some(and_onto(u.where_, e)))

// `u` with `RETURNING` items.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let u = qbbuild.update("users")
//     println("${list.len(qbbuild.update_returning(u, ["id"]).returning)}")
// ```
pub fn update_returning(u: qbast.QbUpdate, names: [Str]) -> qbast.QbUpdate []
    with_update_returning(u, named_columns(names))

// A `DELETE FROM table` with no condition.
//
// Rendered as written, it deletes every row; see `update`.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println(qbbuild.delete("sessions").table)
// ```
pub fn delete(table: Str) -> qbast.QbDelete []
    QbDelete { ctes: [], table: table, where_: None, returning: [] }

// `d` with `e` ANDed onto its condition.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     let d = qbbuild.delete_where(qbbuild.delete("sessions"), qbbuild.is_null("x"))
//     println(d.table)
// ```
pub fn delete_where(d: qbast.QbDelete, e: qbast.QbExpr) -> qbast.QbDelete []
    with_delete_where(d, Some(and_onto(d.where_, e)))

// `d` with `RETURNING` items.
//
// ```novo
// use std.list
// use qbbuild
//
// fn main() [io]
//     let d = qbbuild.delete("sessions")
//     println("${list.len(qbbuild.delete_returning(d, ["id"]).returning)}")
// ```
pub fn delete_returning(d: qbast.QbDelete, names: [Str]) -> qbast.QbDelete []
    with_delete_returning(d, named_columns(names))

// ── one page of rows ─────────────────────────────────────────────────

// `s` with the limit and offset a page of `size` at `page` needs,
// counting pages from zero.
//
// Published because the arithmetic is two lines and is written wrongly
// in two ways — an off-by-one on the page number, and an offset that
// grows without the limit — often enough that it belongs in the
// package that renders it.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.page(qbbuild.select(), 2, 25).offset}")
// ```
pub fn page(s: qbast.QbSelect, page: Int, size: Int) -> qbast.QbSelect []
    let sized = with_limit(s, size)
    with_offset(sized, page * size)

// A `SELECT COUNT(*)` over the same source, joins and conditions as
// `s`, with its columns, ordering, limit and offset dropped.
//
// The query that goes beside a paginated one, and the one a caller
// building by hand gets wrong by leaving the `ORDER BY` on — which
// makes PostgreSQL sort a result set of one row by a column it did not
// select.
//
// ```novo
// use qbbuild
//
// fn main() [io]
//     println("${qbbuild.count_of(qbbuild.select()).limit}")
// ```
pub fn count_of(s: qbast.QbSelect) -> qbast.QbSelect []
    QbSelect { ctes: s.ctes, distinct: s.distinct, distinct_on: s.distinct_on,
               columns: [count_column()], from: s.from, joins: s.joins,
               where_: s.where_, group_by: s.group_by, having: s.having,
               order_by: [], limit: -1, offset: -1, set_arms: s.set_arms,
               for_update: s.for_update }
